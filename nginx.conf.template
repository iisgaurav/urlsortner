server {
    listen ${PORT};
    server_name _;

    # Streamlit websocket support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # API routes go to Django
    location /api/ {
        proxy_pass http://localhost:8000;
    }

    # Admin panel goes to Django
    location /admin/ {
        proxy_pass http://localhost:8000;
    }

    # Static files go to Django
    location /static/ {
        proxy_pass http://localhost:8000;
    }

    # Short code redirects - matches 3-10 alphanumeric characters
    location ~ ^/[a-zA-Z0-9]{3,10}$ {
        proxy_pass http://localhost:8000;
    }

    # Everything else (Streamlit UI)
    location / {
        proxy_pass http://localhost:8501;
    }
}
